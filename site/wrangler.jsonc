// Cloudflare deployment for sergioadan.dev: a static-assets Worker (Cloudflare's successor to
// Pages). No code runs on Cloudflare; it only serves the files build.py writes to dist/.
// Deploy:  python build.py  then  wrangler deploy   (from this folder)
{
  "name": "sergioadan",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "sergioadan.dev", "custom_domain": true },
    { "pattern": "www.sergioadan.dev", "custom_domain": true }
  ]
}
